# Copy outside the checkout with restricted host permissions; never commit secrets.
# These flags stay false until role/provider/TLS qualification and activation.
FASTAPI_ENV=production
ACCOUNT_CLOSURE_ENFORCEMENT_ENABLED=false
ACCOUNT_CLOSURE_AUTHORITY_ENABLED=false
ACCOUNT_CLOSURE_WORKER_ENABLED=false
ACCOUNT_CLOSURE_ACTIONS_ENABLED=false
ACCOUNT_CLOSURE_RETENTION=schedule
ACCOUNT_CLOSURE_WORKER_DATABASE_URL=
KEYCLOAK_ISSUER=
KEYCLOAK_JWKS_URL=
KEYCLOAK_CLIENT_ID=controlplane-frontend
KEYCLOAK_ALLOWED_CLIENT_IDS=
ACCOUNT_CLOSURE_KEYCLOAK_URL=
ACCOUNT_CLOSURE_KEYCLOAK_REALM=
ACCOUNT_CLOSURE_KEYCLOAK_CLIENT_ID=account-closure-worker
ACCOUNT_CLOSURE_KEYCLOAK_CLIENT_SECRET=
ACCOUNT_CLOSURE_OPERATOR_CLIENT_IDS=[]
ACCOUNT_CLOSURE_GUARD_TOKEN=
ACCOUNT_CLOSURE_OPERATIONS_TOKEN=
# The guard and owner HTTPS certificates must be trusted by every native caller.
# Proxy-specific custom CA configuration does not change other services' trust.
ACCOUNT_CLOSURE_GUARD_URL=
ACCOUNT_CLOSURE_KEYS_URL=
ACCOUNT_CLOSURE_HYPERMESH_URL=
# Configure each discovered gateway's existing HTTPS endpoint separately.
# ACCOUNT_CLOSURE_GATEWAY_<UPPERCASE_UUID_WITHOUT_HYPHENS>_URL=

# Immutable separated service image and private TLS listener.
ACCOUNT_CLOSURE_IMAGE=
ACCOUNT_CLOSURE_TLS_CERT_FILE=
ACCOUNT_CLOSURE_TLS_KEY_FILE=
ACCOUNT_CLOSURE_AUTHORITY_CA_FILE=
