# Public reader configuration only. Never copy the private worker env file here.
ACCOUNT_CLOSURE_ENFORCEMENT_ENABLED=false
ACCOUNT_CLOSURE_ACTIONS_ENABLED=false
ACCOUNT_CLOSURE_GUARD_TOKEN=
# Native JWT guards need a certificate trusted by their existing clients.
ACCOUNT_CLOSURE_GUARD_URL=

# Forward to the separately deployed private TLS authority.
ACCOUNT_CLOSURE_AUTHORITY_URL=
ACCOUNT_CLOSURE_AUTHORITY_CA_FILE=
